# Xcode
#
# gitignore contributors: remember to update Global/Xcode.gitignore, Objective-C.gitignore & Swift.gitignore

# 忽略 Carthage 目录，但保留有自定义修改的 PlayTools 文件
/Carthage/*
!/Carthage/Checkouts/
/Carthage/Checkouts/*
!/Carthage/Checkouts/PlayTools/
/Carthage/Checkouts/PlayTools/*
!/Carthage/Checkouts/PlayTools/PlayTools/
!/Carthage/Checkouts/PlayTools/PlayTools.xcodeproj/
/Carthage/Checkouts/PlayTools/PlayTools.xcodeproj/*
!/Carthage/Checkouts/PlayTools/PlayTools.xcodeproj/project.pbxproj
/Carthage/Checkouts/PlayTools/PlayTools.xcodeproj/project.xcworkspace/
!/Carthage/Checkouts/PlayTools/PlayTools.xcodeproj/xcshareddata/
/Carthage/Checkouts/PlayTools/PlayTools.xcodeproj/xcshareddata/*
!/Carthage/Checkouts/PlayTools/PlayTools.xcodeproj/xcshareddata/xcschemes/
/Carthage/Checkouts/PlayTools/PlayTools.xcodeproj/xcshareddata/xcschemes/*
!/Carthage/Checkouts/PlayTools/PlayTools.xcodeproj/xcshareddata/xcschemes/PlayTools.xcscheme
/Carthage/Checkouts/PlayTools/PlayTools/*
!/Carthage/Checkouts/PlayTools/PlayTools/PlaySettings.swift
!/Carthage/Checkouts/PlayTools/PlayTools/PlayCover.swift
!/Carthage/Checkouts/PlayTools/PlayTools/PlayLoader.m
!/Carthage/Checkouts/PlayTools/PlayTools/PlayLoader.h
!/Carthage/Checkouts/PlayTools/PlayTools/MetalCaptureService.swift
!/Carthage/Checkouts/PlayTools/PlayTools/GuardedCapture.h
!/Carthage/Checkouts/PlayTools/PlayTools/GuardedCapture.m
!/Carthage/Checkouts/PlayTools/PlayTools/LibrarySourceInjectionSwizzles.swift
!/Carthage/Checkouts/PlayTools/PlayTools/MetallibParser.swift
!/Carthage/Checkouts/PlayTools/PlayTools/LLVMDisassembler.swift
!/Carthage/Checkouts/PlayTools/PlayTools/IRToMSLConverter.swift
!/Carthage/Checkouts/PlayTools/PlayTools/IRToMSLConverter+AirBuiltins.swift
!/Carthage/Checkouts/PlayTools/PlayTools/IRToMSLConverter+Metadata.swift
!/Carthage/Checkouts/PlayTools/PlayTools/IRToMSLConverter+IRParsing.swift
!/Carthage/Checkouts/PlayTools/PlayTools/IRToMSLConverter+BodyTranslation.swift
!/Carthage/Checkouts/PlayTools/PlayTools/IRToMSLConverter+InstructionTranslation.swift
!/Carthage/Checkouts/PlayTools/PlayTools/IRToMSLConverter+CodeGeneration.swift
!/Carthage/Checkouts/PlayTools/PlayTools/Controls/
/Carthage/Checkouts/PlayTools/PlayTools/Controls/*
!/Carthage/Checkouts/PlayTools/PlayTools/Controls/Backend/
/Carthage/Checkouts/PlayTools/PlayTools/Controls/Backend/*
!/Carthage/Checkouts/PlayTools/PlayTools/Controls/Backend/Bridge/
/Carthage/Checkouts/PlayTools/PlayTools/Controls/Backend/Bridge/*
!/Carthage/Checkouts/PlayTools/PlayTools/Controls/Backend/Bridge/BridgeListener.swift
.DS_store
/vendor
/output
/apikey.json
Package.resolved

## User settings
xcuserdata/

## compatibility with Xcode 8 and earlier (ignoring not required starting Xcode 9)
*.xcscmblueprint
*.xccheckout

## compatibility with Xcode 3 and earlier (ignoring not required starting Xcode 4)
build/
DerivedData/
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3

## Obj-C/Swift specific
*.hmap

## App packaging
*.ipa
*.dSYM.zip
*.dSYM

## Playgrounds
timeline.xctimeline
playground.xcworkspace

# Swift Package Manager
#
# Add this line if you want to avoid checking in source code from Swift Package Manager dependencies.
# Packages/
# Package.pins
# Package.resolved
# *.xcodeproj
#
# Xcode automatically generates this directory with a .xcworkspacedata file and xcuserdata
# hence it is not needed unless you have added a package configuration file to your project
# .swiftpm

.build/

# CocoaPods
#
# We recommend against adding the Pods directory to your .gitignore. However
# you should judge for yourself, the pros and cons are mentioned at:
# https://guides.cocoapods.org/using/using-cocoapods.html#should-i-check-the-pods-directory-into-source-control
#
# Pods/
#
# Add this line if you want to avoid checking in source code from the Xcode workspace
# *.xcworkspace

# Carthage
#
# Add this line if you want to avoid checking in source code from Carthage dependencies.
# Carthage/Checkouts

Carthage/Build/

# Accio dependency management
Dependencies/
.accio/

# fastlane
#
# It is recommended to not store the screenshots in the git repo.
# Instead, use fastlane to re-generate the screenshots whenever they are needed.
# For more information about the recommended setup visit:
# https://docs.fastlane.tools/best-practices/source-control/#source-control

fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# Code Injection
#
# After new code Injection tools there's a generated folder /iOSInjectionProject
# https://github.com/johnno1962/injectionforxcode

iOSInjectionProject/
xcuserdata/*
# Python
__pycache__/
*.pyc

# Logs
*.log

# Temporary analysis data
LocalDocs/XCodeOperation/renderanalysistask/pipeline_passes.json
LocalDocs/XCodeOperation/renderanalysistask/re_breadcrumbs.json
dependencies/
